# ---------------------------------------------------------------------------
# Cliente 3D — copiar a .env.local. Sólo variables VITE_* llegan al bundle:
# nunca poner acá un secreto que no pueda ser público.
# ---------------------------------------------------------------------------

# Clima. Open-Meteo no necesita clave; OpenWeatherMap sí (la clave queda expuesta
# en el bundle: usar una restringida por dominio, o proxearla desde PHP).
VITE_WEATHER_PROVIDER=open-meteo
VITE_OPENWEATHER_API_KEY=
VITE_WEATHER_REFRESH_MINUTES=10

# Backend y tiempo real.
#
# La API va SIN prefijo de versión: los archivos viven en public_html/api/ y se
# piden como /api/auth/login.php. Un `/api/v1` acá da 404 en todas las llamadas
# —no hay carpeta v1 ni regla que la reescriba—, que es exactamente el error que
# esconde el primer despliegue.
VITE_API_BASE_URL=https://TU-DOMINIO/api
VITE_REALTIME_URL=wss://rt.TU-DOMINIO

# Día del comicio (ISO UTC). Cambiar cuando se publique la fecha oficial.
VITE_ELECTION_DAY=2027-06-13T11:00:00.000Z
VITE_ELECTION_DATE_OFFICIAL=false

# Render
VITE_RENDER_DISTANCE_CELLS=6
VITE_MAX_PIXEL_RATIO=2
