# =====================================================================
#  MÉTRICA — configuración. Copiá a .env y ajustá en tu VPS.
# =====================================================================

# --- Puerto del VPS (por dónde entrás: http://IP_DEL_VPS:HOST_PORT) ---
# Default 3013 para no chocar con 3010/3011/3012 ya usados.
HOST_PORT=3013

# --- Seguridad (¡CAMBIAR!) ---
# Generá una clave larga: openssl rand -hex 32
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# Admin inicial (se crea solo la primera vez). Cambiá la contraseña.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-contrasena
ADMIN_EMAIL=admin@metrica.local

# --- Postgres (docker-compose lo levanta solo) ---
POSTGRES_USER=metrica
POSTGRES_PASSWORD=cambiar-password-db
POSTGRES_DB=metrica

# --- Anti-bloqueo del scraping ---
# Proxy residencial/rotativo. EL factor decisivo desde un datacenter.
PROXY_URL=
MIN_DELAY=2.0
MAX_DELAY=6.0
MAX_RETRIES=3
BLOCK_RESOURCES=true

# --- Navegador ---
HEADLESS=true
PLAYWRIGHT_EXECUTABLE_PATH=
