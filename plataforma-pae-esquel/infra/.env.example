# ============================================================
# TROCHA · variables de entorno
# Copiar a .env y completar. NUNCA versionar el .env real.
# ============================================================

# --- Puerto público del stack ---
# Elegido fuera de los rangos habituales y del rango efímero del kernel.
TROCHA_PORT=13787

# --- Base de datos ---
POSTGRES_USER=trocha
POSTGRES_DB=trocha
# Generar con: openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIAR_ESTO

# --- Aplicación ---
# Generar con: openssl rand -base64 48
AUTH_SECRET=CAMBIAR_ESTO
APP_URL=http://TU_IP_O_DOMINIO:13787

# --- Respaldos ---
# Destino del respaldo cifrado fuera del servidor (rclone, scp, S3…).
BACKUP_DESTINO=
# Generar con: openssl rand -base64 32
BACKUP_PASSPHRASE=CAMBIAR_ESTO
