{
  "name": "relevamiento-barrial-esquel",
  "version": "0.6.0",
  "private": true,
  "description": "Sistema de relevamiento barrial casa por casa - Municipalidad de Esquel (Chubut)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-3000}",
    "build": "next build",
    "start": "next start --port ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "audio:procesar": "tsx scripts/procesar-audios.ts",
    "audio:purgar": "tsx scripts/purgar-audios.ts",
    "audio:verificar": "tsx scripts/verificar-transcripcion.ts",
    "cuestionario:publicar": "tsx scripts/publicar-cuestionario.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@radix-ui/react-slot": "^1.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "next": "^15.5.25",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.25",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
