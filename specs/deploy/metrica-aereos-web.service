[Unit]
Description=Metrica Aereos Consultation Web Server (Port 38530)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/metrica-aereos
Environment="PYTHONPATH=/opt/metrica-aereos"
ExecStart=/opt/metrica-aereos/venv/bin/python -m aereos.server --host 0.0.0.0 --port 38530
Restart=always
RestartSec=5
Nice=10
MemoryMax=256M
CPUQuota=30%

[Install]
WantedBy=multi-user.target
