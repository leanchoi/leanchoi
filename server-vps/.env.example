# ---------------------------------------------------------------------------
# Esquel 2027 — servidor autoritativo (VPS). Copiar a .env y completar.
# NINGÚN valor real se versiona.
#
# El archivo lo lee Node de forma nativa (`--env-file-if-exists=.env`, ya puesto
# en el script `start` y en `node_args` de PM2). No hace falta dotenv. Si el
# archivo no existe, el proceso arranca igual y se cae con un error claro
# apenas falte una variable obligatoria.
#
# En producción son obligatorias JWT_SECRET (mínimo 32 caracteres) y
# HOSTINGER_API_KEY: sin ellas el servidor se niega a arrancar, a propósito.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=2567
LOG_LEVEL=debug

# Identidad del shard. Sin guión largo: viaja en una cabecera HTTP y las
# cabeceras son Latin-1. El servidor lo sanea igual, pero mejor no darle trabajo.
SHARD_NAME=Esquel - Centro 01
SHARD_CAPACITY=120

# JWT HS256: el MISMO secreto que usa Hostinger para firmar.
# En producción, mínimo 32 caracteres (el server se niega a arrancar si no).
JWT_SECRET=
JWT_ISSUER=https://esquel2027.ar
JWT_AUDIENCE=esquel-realtime
JWT_CLOCK_TOLERANCE_S=60

# Puente con Hostinger (persistencia de XP, guita y reputación)
HOSTINGER_API_URL=https://esquel2027.ar/api
HOSTINGER_API_KEY=
HOSTINGER_FLUSH_MS=30000
HOSTINGER_TIMEOUT_MS=8000

# Orígenes permitidos, separados por coma. Los subdominios del dominio declarado
# entran solos (www., staging.), así que no hace falta listarlos uno por uno.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,https://esquel2027.ar

# Mundo
AOI_CELLS=4
VOICE_RANGE_M=25
TICK_HZ=20
AOI_HZ=10
