# ---------------------------------------------------------------------------
# Esquel 2027 — servidor autoritativo (VPS). Copiar a .env y completar.
# NINGÚN valor real se versiona.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=2567
LOG_LEVEL=info

# Identidad del shard (aparece en el selector y en las métricas)
SHARD_NAME=Esquel — Centro 01
SHARD_CAPACITY=120

# Backend de Hostinger
API_BASE_URL=https://esquel2027.ar/api/v1
API_JWKS_URL=https://esquel2027.ar/api/v1/auth/jwks
# Secreto compartido para firmar los lotes de persistencia (HMAC-SHA256)
API_INTERNAL_HMAC_SECRET=

# Emisor y audiencia esperados en el access token
JWT_ISSUER=https://esquel2027.ar
JWT_AUDIENCE=esquel-realtime

# Redis: presencia entre shards, denylist de jti y cola de persistencia
REDIS_URL=redis://127.0.0.1:6379

# Proveedor de clima (ver decisión #3 del traspaso al PROMPT 1)
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_LAT=-42.9139
WEATHER_LON=-71.3241
WEATHER_REFRESH_SECONDS=600

# Live-Ops: ingesta de noticias locales
NEWS_FEEDS=
NEWS_POLL_SECONDS=900

# CORS del cliente
ALLOWED_ORIGINS=https://esquel2027.ar,http://localhost:5173
