{
  "name": "@esquel/server-vps",
  "version": "0.2.0",
  "private": true,
  "description": "Servidor autoritativo de juego (Node.js + Colyseus): estado 3D, misiones Live-Ops, territorio y señalización de voz.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --alias:@esquel/shared/protocol=../shared/protocol/index.ts --alias:@esquel/shared=../shared/index.ts --packages=external --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@colyseus/monitor": "^0.15.6",
    "@colyseus/schema": "^2.0.36",
    "@colyseus/ws-transport": "^0.15.3",
    "@esquel/shared": "*",
    "colyseus": "^0.15.17",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2"
  }
}
