# ── Puerto del VPS ────────────────────────────────────────────────────────
# HOST_PORT es el puerto EXTERNO: el que abrís en el navegador
# (http://IP_DEL_VPS:HOST_PORT) y en el firewall. El puerto interno del
# contenedor es 4000 y no se toca.
# Antes de elegirlo, comprobá qué está libre en el VPS:
#   docker ps --format 'table {{.Names}}\t{{.Ports}}'
#   sudo ss -tlnp | grep LISTEN
HOST_PORT=3010

# ── Seguridad de sesiones ─────────────────────────────────────────────────
# Clave con la que se firman las sesiones. Generá una propia con:
#   openssl rand -hex 32
NEXTAUTH_SECRET=cambia_esto_por_una_clave_segura_aleatoria

# URL pública con la que accedés a la app (IP:puerto o dominio)
NEXTAUTH_URL=http://IP_DEL_VPS:3010
