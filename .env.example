# ── Base ─────────────────────────────────────────────────────────────────────
# URL publica del sitio master (sin barra final)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Dominio del sitio master (los demas hosts se tratan como sitios white-label)
MASTER_DOMAIN=localhost:3000
# Dominio raiz de la plataforma para subdominios de tenants (pepito.tudominio.com)
PLATFORM_DOMAIN=localhost:3000

# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://andar:andar@localhost:5432/andar

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET=cambiame-por-un-secreto-largo-y-aleatorio

# ── Mercado Pago (modelo marketplace / split de pagos) ───────────────────────
# Credenciales de TU aplicacion "marketplace" creada en
# https://www.mercadopago.com.ar/developers/panel/app (tipo: MarketPlace)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Access token de la cuenta MASTER (para inventario propio, 100% para vos)
MP_ACCESS_TOKEN=
# Public key de la cuenta master (frontend)
NEXT_PUBLIC_MP_PUBLIC_KEY=

# ── Integraciones OTA (opcionales) ───────────────────────────────────────────
VIATOR_API_KEY=
GYG_PARTNER_ID=
CIVITATIS_AFFILIATE_ID=
