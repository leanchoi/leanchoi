# =============================================================================
#  Relevamiento Barrial Esquel — variables de entorno
#  Copiar a .env y completar.  NUNCA commitear el .env real.
#  Los valores marcados como GENERAR se producen con los comandos de HANDOFF.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
# Entorno de ejecución: development | test | production
NODE_ENV=production

# Puerto de la aplicación. ÚNICO lugar donde se define el puerto: lo usa el
# proceso Next, el publicado de docker compose, los tests e2e y el healthcheck.
# Elegir uno libre en el host antes de desplegar (ver HANDOFF.md).
PORT=3000

# Interfaz del host donde publica el contenedor.
# 0.0.0.0 expone a la red; 127.0.0.1 si hay un proxy inverso con TLS delante
# (recomendado en producción).
APP_BIND=0.0.0.0

# Nombre visible del sistema.
APP_NAME=Relevamiento Barrial Esquel

# URL pública completa (la que ve el vecino en el ticket y en los acuses).
# En producción DEBE ser https://
APP_BASE_URL=http://localhost:3000

# Zona horaria de toda la operación.
TZ=America/Argentina/Buenos_Aires

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Base de datos (Postgres 16)
# Una sola instancia, dos schemas separados: `analitica` e `identificada`.
# -----------------------------------------------------------------------------
POSTGRES_USER=relevamiento
# GENERAR: openssl rand -base64 24
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=relevamiento

# Cadena de conexión que usa la aplicación.
# Dentro de docker compose el host es `db` (nombre del servicio).
DATABASE_URL=postgres://relevamiento:cambiar_esta_clave@db:5432/relevamiento
# Para desarrollo fuera de Docker (con docker-compose.dev.yml publicando la base):
# DATABASE_URL=postgres://relevamiento:cambiar_esta_clave@127.0.0.1:5432/relevamiento

# Tamaño máximo del pool de conexiones.
DATABASE_POOL_MAX=10

# true si la base exige TLS (base gestionada externa). Con la base de compose: false.
DATABASE_SSL=false

# Puerto local donde publicar Postgres SOLO en desarrollo (docker-compose.dev.yml).
POSTGRES_PUBLIC_PORT=5432

# -----------------------------------------------------------------------------
# Sesiones (auth propia, sin proveedores externos)
# -----------------------------------------------------------------------------
# GENERAR: openssl rand -hex 32   (mínimo 32 caracteres)
# Si se cambia, se cierran todas las sesiones abiertas.
SESSION_SECRET=generar_con_openssl_rand_hex_32

# Nombre de la cookie de sesión (httpOnly, SameSite=Lax).
SESSION_COOKIE_NAME=rbe_sesion

# Duración de la sesión del personal en horas.
SESSION_TTL_HORAS=12

# true en producción (exige HTTPS). Solo poner false para desarrollo local.
SESSION_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Correo — acuses de recibo al vecino
# -----------------------------------------------------------------------------
# console = imprime el mail en el log y NO envía nada (obligatorio en desarrollo)
# smtp    = envío real
MAIL_TRANSPORT=console
MAIL_FROM=juntasvecinales@esquel.local
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Feature flags — audio y codificación de preguntas abiertas
# El sistema funciona completo con todos estos flags apagados.
# -----------------------------------------------------------------------------
# Grabación de respuestas abiertas por voz en la app de campo.
FEATURE_AUDIO=false
# Transcripción de los audios.
FEATURE_TRANSCRIPCION=false
# Agrupamiento temático de las transcripciones.
FEATURE_CLUSTERING=false

# Proveedores: stub (determinístico, sin red, para desarrollo y tests) | anthropic
TRANSCRIPTION_PROVIDER=stub
CLUSTERING_PROVIDER=stub

# Solo si algún proveedor es `anthropic`.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# -----------------------------------------------------------------------------
# Operación
# -----------------------------------------------------------------------------
# Carpeta de backups (montada en el contenedor de mantenimiento).
BACKUP_DIR=./backups
# Días de retención de dumps locales. 0 = no purgar.
BACKUP_RETENCION_DIAS=30
