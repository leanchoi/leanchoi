# =============================================================================
#  Relevamiento Barrial Esquel — variables de entorno
#  Copiar a .env y completar.  NUNCA commitear el .env real.
#  Los valores marcados como GENERAR se producen con los comandos de HANDOFF.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
# Entorno de ejecución: development | test | production
NODE_ENV=production

# Puerto de la aplicación. ÚNICO lugar donde se define el puerto: lo usa el
# proceso Next, el publicado de docker compose, los tests e2e y el healthcheck.
# Elegir uno libre en el host antes de desplegar (ver HANDOFF.md).
PORT=3000

# Interfaz del host donde publica el contenedor.
# 0.0.0.0 expone a la red; 127.0.0.1 si hay un proxy inverso con TLS delante
# (recomendado en producción).
APP_BIND=0.0.0.0

# Nombre visible del sistema.
APP_NAME="Relevamiento Barrial Esquel"

# URL pública completa (la que ve el vecino en el ticket y en los acuses).
# En producción DEBE ser https://
APP_BASE_URL=http://localhost:3000

# Zona horaria de toda la operación.
TZ=America/Argentina/Buenos_Aires

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Base de datos (Postgres 16)
# Una sola instancia, dos schemas separados: `analitica` e `identificada`.
# -----------------------------------------------------------------------------
POSTGRES_USER=relevamiento
# GENERAR: openssl rand -base64 24
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=relevamiento

# Cadena de conexión que usa la aplicación.
# Dentro de docker compose el host es `db` (nombre del servicio).
DATABASE_URL=postgres://relevamiento:cambiar_esta_clave@db:5432/relevamiento
# Para desarrollo fuera de Docker (con docker-compose.dev.yml publicando la base):
# DATABASE_URL=postgres://relevamiento:cambiar_esta_clave@127.0.0.1:5432/relevamiento

# Tamaño máximo del pool de conexiones.
DATABASE_POOL_MAX=10

# true si la base exige TLS (base gestionada externa). Con la base de compose: false.
DATABASE_SSL=false

# Puerto local donde publicar Postgres SOLO en desarrollo (docker-compose.dev.yml).
POSTGRES_PUBLIC_PORT=5432

# -----------------------------------------------------------------------------
# Sesiones (auth propia, sin proveedores externos)
# -----------------------------------------------------------------------------
# GENERAR: openssl rand -hex 32   (mínimo 32 caracteres)
# Si se cambia, se cierran todas las sesiones abiertas.
SESSION_SECRET=generar_con_openssl_rand_hex_32

# Nombre de la cookie de sesión (httpOnly, SameSite=Lax).
SESSION_COOKIE_NAME=rbe_sesion

# Duración de la sesión del personal en horas.
SESSION_TTL_HORAS=12

# true en producción (exige HTTPS). Solo poner false para desarrollo local.
SESSION_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Frenos y techos
# -----------------------------------------------------------------------------
# Intentos de login por IP y usuario antes de responder 429.
LOGIN_MAX_INTENTOS=8
LOGIN_VENTANA_MINUTOS=5
# Consultas de ticket por IP (apellido + últimos 3 del DNI).
TICKET_MAX_CONSULTAS=20
TICKET_VENTANA_MINUTOS=10
# Techo del lote de sincronización, en KB. Un celular que estuvo una semana sin
# señal manda mucho, pero no infinito.
SYNC_MAX_KB=4096

# -----------------------------------------------------------------------------
# Correo — acuses de recibo al vecino
# -----------------------------------------------------------------------------
# console = imprime el mail en el log y NO envía nada (obligatorio en desarrollo)
# smtp    = envío real
MAIL_TRANSPORT=console
MAIL_FROM=juntasvecinales@esquel.local
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Feature flags
# El sistema funciona completo con todos estos flags apagados.
# -----------------------------------------------------------------------------
# Grabación de respuestas abiertas por voz en la app de campo.
FEATURE_AUDIO=false
# Desgrabación automática de los audios (requiere un proveedor configurado).
FEATURE_TRANSCRIPCION=false
# Agrupamiento temático de las transcripciones (fase 7).
FEATURE_CLUSTERING=false

# -----------------------------------------------------------------------------
# Audio — es TEMPORAL por diseño
# El audio se borra apenas la desgrabación queda asegurada, y en todos los casos
# al vencer AUDIO_TTL_HORAS. Detalle completo en docs/audio-y-transcripcion.md.
# -----------------------------------------------------------------------------
# Dónde se guardan los audios mientras existen.
# En docker compose es un volumen: /app/datos/audios
AUDIO_DIR=./datos/audios

# Tamaño máximo por audio en MB. Gemini no acepta pedidos de más de 20 MB inline.
AUDIO_MAX_MB=20

# Formatos que se aceptan desde el celular (el navegador suele grabar webm/opus).
AUDIO_MIMES_PERMITIDOS=audio/webm,audio/ogg,audio/mp4,audio/mpeg,audio/wav,audio/flac,audio/aac,audio/aiff

# Tope duro de permanencia. Vencido el plazo el audio se borra aunque no se haya
# podido desgrabar. Es lo que evita que se acumulen archivos sin procesar.
AUDIO_TTL_HORAS=72

# Reintentos de desgrabación antes de dejar el audio en error.
AUDIO_REINTENTOS_MAX=3
# Cuántos audios procesa cada corrida del worker.
AUDIO_LOTE_PROCESO=10
# Idioma sugerido al proveedor.
AUDIO_IDIOMA=es-AR

# GENERAR: openssl rand -hex 24
# Autoriza POST /api/audios/procesar. Sin esto, la desgrabación solo se dispara
# por línea de comandos (npm run audio:procesar).
AUDIO_WORKER_TOKEN=

# Ruta a ffmpeg si no está en el PATH. Se usa para convertir el audio al formato
# que acepta el proveedor. En la imagen Docker ya viene instalado.
# FFMPEG_PATH=/usr/bin/ffmpeg

# -----------------------------------------------------------------------------
# Proveedor de desgrabación (speech-to-text)
#   stub              determinístico, sin red ni claves. Por defecto.
#   gemini            API de Google (Generative Language API).
#   openai_compatible cualquier servicio con la API de OpenAI, incluido un
#                     Whisper autohospedado (el audio no sale del servidor).
# -----------------------------------------------------------------------------
TRANSCRIPTION_PROVIDER=stub

# --- Gemini ---
# Clave de Google AI Studio. Ver docs/audio-y-transcripcion.md para el paso a paso.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-transcribe
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# interactions     = API de transcripción (modelos dedicados)
# generate_content = API clásica multimodal
GEMINI_ESTILO=interactions
GEMINI_PROMPT="Transcribí literalmente el audio en español rioplatense. Devolvé solo el texto, sin comentarios ni encabezados."
GEMINI_TIMEOUT_MS=120000

# --- Servicio compatible con la API de OpenAI (Whisper propio, etc.) ---
# STT_OPENAI_BASE_URL=http://whisper:8000/v1
# STT_OPENAI_API_KEY=
STT_OPENAI_MODEL=whisper-1
STT_OPENAI_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# Agrupamiento temático de respuestas abiertas
# Todo esto es opcional: con FEATURE_CLUSTERING=false el sistema funciona completo.
# Ver docs/codificacion.md.
# -----------------------------------------------------------------------------
# stub      = determinístico, local, sin red ni claves (por defecto).
# anthropic = agrupa con la API de Anthropic.
CLUSTERING_PROVIDER=stub
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
CLUSTERING_TIMEOUT_MS=600000
# Tope de temas por pregunta: más de una docena no entra en una carilla A4.
CLUSTERING_MAX_TEMAS=10
# Transcripciones por corrida del worker (npm run codificar).
CLUSTERING_LOTE=120
# Debajo de esto no se agrupa: con tres textos no hay temas, hay tres textos.
CLUSTERING_MINIMO_FRAGMENTOS=5

# -----------------------------------------------------------------------------
# Operación
# -----------------------------------------------------------------------------
# Carpeta de backups (montada en el contenedor de mantenimiento).
BACKUP_DIR=./backups
# Días de retención de dumps locales. 0 = no purgar.
BACKUP_RETENCION_DIAS=30
