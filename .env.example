# ─── Postgres ───────────────────────────────────────────────
POSTGRES_USER=rutas
POSTGRES_PASSWORD=cambiame_por_algo_fuerte
POSTGRES_DB=rutas

# ─── API (interno, NO expuesto al host) ─────────────────────
API_PORT=8080
ADMIN_TOKEN=genera_un_token_largo_aleatorio
STORAGE_DIR=/storage
# mismo host:puerto que abre el navegador (debe coincidir con WEB_PORT)
PUBLIC_BASE_URL=http://TU_VPS_IP:48210
DATABASE_URL=postgres://rutas:cambiame_por_algo_fuerte@db:5432/rutas

# ─── WEB — el único puerto publicado en el VPS ──────────────
WEB_PORT=48210
