# =====================================================================
#  Configuracion del scraper de precios (Booking + Airbnb)
#  Copia este archivo a .env y ajusta los valores en tu VPS.
# =====================================================================

# --- Base de datos ---
# Por defecto SQLite (cero configuracion). Para Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/precios
DATABASE_URL=sqlite:///data/prices.db

# --- Navegador (Playwright) ---
# Deja vacio para que Playwright use su Chromium por defecto.
# En este entorno el binario preinstalado esta en:
#   /opt/pw-browsers/chromium-1194/chrome-linux/chrome
PLAYWRIGHT_EXECUTABLE_PATH=
HEADLESS=true

# --- Anti-bloqueo ---
# Proxy (idealmente residencial/rotativo). Es EL factor decisivo para
# vencer las barreras de Booking/Airbnb desde un datacenter/VPS.
# Ejemplos:
#   PROXY_URL=http://usuario:password@gw.proxy.com:8000
#   PROXY_URL=socks5://usuario:password@host:1080
PROXY_URL=

# Retrasos humanos (segundos) entre acciones y peticiones
MIN_DELAY=1.5
MAX_DELAY=4.0

# Reintentos por peticion cuando se detecta bloqueo/captcha
MAX_RETRIES=3

# Bloquear imagenes/fuentes/media para ir mas rapido (recomendado)
BLOCK_RESOURCES=true

# --- Parametros de busqueda por defecto ---
DEFAULT_CURRENCY=EUR
DEFAULT_ADULTS=2
DEFAULT_NIGHTS=2
# Cuantos dias en el futuro empieza el check-in por defecto
DEFAULT_CHECKIN_OFFSET_DAYS=30
# Cuantas paginas de resultados recorrer como maximo por plataforma
MAX_PAGES=2

# --- Servidor web ---
HOST=0.0.0.0
PORT=8000
