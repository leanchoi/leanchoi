{
  "name": "esquel/backend-php",
  "description": "Esquel 2027 — API REST, identidad, persistencia y motor de inteligencia (Hostinger).",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-json": "*",
    "ext-sodium": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Esquel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Esquel\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "phpunit --testdox"
  }
}
