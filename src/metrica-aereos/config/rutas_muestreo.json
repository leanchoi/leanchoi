{
  "_doc": "Configuración de cadencia de Métrica Aéreos. Ver docs/01 §4.",
  "_presupuesto_esperado": "≈160 consultas/día. Tope duro: 250.",

  "global": {
    "tope_consultas_dia": 250,
    "espaciado_segundos": { "min": 15, "max": 45 },
    "pausa_larga": { "cada_n_consultas": 25, "segundos": { "min": 180, "max": 480 } },
    "ventana_horaria_art": { "inicio": "02:00", "fin": "05:00" },
    "concurrencia": 1,
    "circuit_breaker_fallos_consecutivos": 3,
    "backoff_segundos": [60, 300, 900],
    "moneda_primaria": "ARS",
    "moneda_secundaria": "USD",
    "moneda_secundaria_solo_tiers": [1, 2],
    "locale": { "hl": "es-AR", "gl": "AR" },
    "orden": "aleatorio_con_pesos_por_tier"
  },

  "tiers": {
    "1": { "nombre": "Núcleo",                "cadencia_dias": 1, "descripcion": "Objeto del observatorio" },
    "2": { "nombre": "Benchmark primario",    "cadencia_dias": 1, "descripcion": "Sustitutos cordilleranos; habilitan la comparación transversal del día 1" },
    "3": { "nombre": "Benchmark secundario",  "cadencia_dias": 3, "descripcion": "Contexto patagónico" },
    "4": { "nombre": "Combustible regresión", "cadencia_dias": 7, "descripcion": "Sin estas rutas el modelo hedónico no tiene identificación (docs/02 §3.2)" }
  },

  "rutas": [
    { "origen": "BUE", "destino": "EQS", "tier": 1 },
    { "origen": "COR", "destino": "EQS", "tier": 1, "nota": "sin vuelo directo: siempre con conexión" },
    { "origen": "BUE", "destino": "BRC", "tier": 2 },
    { "origen": "BUE", "destino": "CPC", "tier": 2 },
    { "origen": "COR", "destino": "BRC", "tier": 2 },
    { "origen": "BUE", "destino": "PMY", "tier": 3 },
    { "origen": "BUE", "destino": "REL", "tier": 3 },
    { "origen": "BUE", "destino": "CRD", "tier": 3 },
    { "origen": "BUE", "destino": "USH", "tier": 3 },
    { "origen": "BUE", "destino": "FTE", "tier": 3 },
    { "origen": "BUE", "destino": "MDZ", "tier": 4 },
    { "origen": "BUE", "destino": "NQN", "tier": 4 },
    { "origen": "BUE", "destino": "IGR", "tier": 4 },
    { "origen": "BUE", "destino": "SLA", "tier": 4 },
    { "origen": "BUE", "destino": "JUJ", "tier": 4 },
    { "origen": "BUE", "destino": "TUC", "tier": 4 },
    { "origen": "BUE", "destino": "RGL", "tier": 4 },
    { "origen": "BUE", "destino": "RGA", "tier": 4 },
    { "origen": "BUE", "destino": "BHI", "tier": 4 },
    { "origen": "BUE", "destino": "MDQ", "tier": 4 },
    { "origen": "COR", "destino": "MDZ", "tier": 4 },
    { "origen": "COR", "destino": "NQN", "tier": 4 }
  ],

  "conjuntos_de_fechas": {
    "ancla": {
      "descripcion": "Fechas de alto valor analítico. Concentran el poder de las curvas de anticipación.",
      "generadores": [
        { "tipo": "dia_semana", "dia": "viernes" },
        { "tipo": "feriados_y_puentes", "fuente": "calendario.json" },
        { "tipo": "hito", "nombre": "Invierno / La Hoya",    "desde": "07-01", "hasta": "08-31", "muestras": 8 },
        { "tipo": "hito", "nombre": "Tulipanes Trevelin",    "desde": "10-01", "hasta": "11-15", "muestras": 6 },
        { "tipo": "hito", "nombre": "Verano",                "desde": "01-05", "hasta": "02-20", "muestras": 6 },
        { "tipo": "hito", "nombre": "Eclipse 2027",          "desde": "2027-07-20", "hasta": "2027-07-24", "muestras": 5 }
      ],
      "observacion": [
        { "rango_lead_dias": [1, 45],  "cada_dias": 1 },
        { "rango_lead_dias": [46, 90], "cada_dias": 3 }
      ],
      "trip_type": "round_trip",
      "return_offset_dias": 3
    },
    "rolling": {
      "descripcion": "Cobertura continua de corto plazo, excluyendo fechas ancla ya cubiertas.",
      "rango_lead_dias": [1, 30],
      "cada_dias": 3,
      "trip_type": "one_way"
    },
    "checkpoints": {
      "descripcion": "Curva de largo plazo y apertura de ventas de temporada.",
      "lead_dias": [45, 60, 90, 120, 150, 180],
      "cada_dias": 7,
      "trip_type": "one_way"
    }
  },

  "buckets_lead_time": {
    "_nota": "DEBEN coincidir con los de specs/sql/02_metrica_contract.sql o las curvas cruzadas no son comparables.",
    "limites": [2, 6, 13, 20, 29, 44, 59, 89, 119]
  },

  "fallback_serpapi": {
    "habilitado": true,
    "solo_tiers": [1, 2],
    "solo_conjunto": "ancla",
    "solo_ventana_accionable": true,
    "tope_mensual": 800,
    "detener_al_alcanzar_tope": true
  },

  "sonda_playwright": {
    "_nota": "Enriquecimiento OPCIONAL. Ningún indicador crítico puede depender de esto (invariante I9).",
    "habilitado": false,
    "objetivo": "aerolineas.com.ar",
    "rutas": [["AEP", "EQS"], ["AEP", "BRC"]],
    "tope_semanal": 20,
    "reutilizar_browsers_path": true,
    "captura": ["fare_brand", "seats_remaining"]
  }
