{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@esquel/shared": [
        "./shared/index.ts"
      ],
      "@esquel/shared/*": [
        "./shared/*"
      ]
    }
  },
  "include": [
    "shared/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/.build"
  ]
}
